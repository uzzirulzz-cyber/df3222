# Cloudflare Worker config for IPTV Stream Proxy
#
# HOW TO USE:
# 1. Copy this file to `wrangler.toml` (don't commit the real one)
# 2. Replace <YOUR_ACCOUNT_ID> with your Cloudflare account ID
#    (find it at https://dash.cloudflare.com → any domain → right sidebar)
# 3. Set UPSTREAM_ALLOWLIST to your IPTV provider's hostname (strongly recommended)
# 4. Optional: set UPSTREAM_USERNAME / UPSTREAM_PASSWORD if your provider requires
#    HTTP basic auth on stream URLs (Xtream Codes does NOT typically need this —
#    credentials are already in the URL path)
# 5. Run: npx wrangler deploy

name = "iptv-stream-proxy"
main = "src/index.ts"
compatibility_date = "2024-12-01"
compatibility_flags = ["nodejs_compat"]

account_id = "<YOUR_ACCOUNT_ID>"

# STRONGLY RECOMMENDED: restrict which upstream hosts the worker will fetch from.
# Without this, anyone can use your worker as a generic streaming proxy.
# Comma-separated substring match against the upstream hostname.
[vars]
UPSTREAM_ALLOWLIST = "advance.playbeat.live,playbeat.live"

# Optional: HTTP basic auth to upstream (most Xtream Codes providers do NOT need this —
# credentials are in the URL path)
# UPSTREAM_USERNAME = ""
# UPSTREAM_PASSWORD = ""

# Optional: custom domain
# [[routes]]
# pattern = "stream.yourdomain.com/*"
# custom_domain = true
